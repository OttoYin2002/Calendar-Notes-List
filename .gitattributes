# 统一换行符策略，避免跨平台协作时整个文件被标记为"已修改"
# 默认：仓库内一律用 LF
* text=auto eol=lf

# Windows 批处理脚本必须用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.exe binary
*.pyc binary

# 明确标记为文本的文件
*.py text
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
